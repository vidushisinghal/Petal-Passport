# Mapbox public token (starts with pk.) — exposed to the browser
NEXT_PUBLIC_MAPBOX_TOKEN=

# Narrator's first name for "Narrated by X" label on the audio player
NEXT_PUBLIC_NARRATOR_NAME=

# ElevenLabs — server-side only, never expose these
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Unsplash — only needed locally when running `npm run fetch-photos`
UNSPLASH_ACCESS_KEY=
